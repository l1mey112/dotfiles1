# https://stackoverflow.com/questions/1057564/pretty-git-branch-graphs

[alias]
lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all

st = stash --include-untracked                # stash all
sts = stash	--staged                          # stash staged
stc = stash	--keep-index --include-untracked  # stash changes
spop = stash pop --index

# --include-untracked stashes changes from untracked files too
# need --index so that a stash pop preserves staged and unstaged changes

