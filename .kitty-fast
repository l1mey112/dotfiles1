#!/bin/sh
# https://sw.kovidgoyal.net/kitty/invocation/
# https://github.com/kovidgoyal/kitty/issues/6834
# https://sources.debian.org/src/kitty/0.41.1-2%2Bdeb13u2/debian/rules/
# https://bugs.debian.org/cgi-bin/pkgreport.cgi?src=kitty
set -eu

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/kitty/pycache"
mkdir -p "$cache_dir"

# NOTE: you MUST start picom before the first kitty because --single-instance reuses the
#       initial rendering state. if the first process started without picom, new windows
#       will stay opaque

exec env PYTHONPYCACHEPREFIX="$cache_dir" /usr/bin/kitty --single-instance "$@"
