#!/bin/sh
REAL_NODE="/usr/bin/node"
SPOOF="$HOME/.local/libexec/nodespoof/nodespoof.cjs"

case "$1" in
  -v|--version) echo "v22.20.0"; exit 0 ;;
esac

case " $NODE_OPTIONS " in
  *" --require $SPOOF "*) ;;
  *) NODE_OPTIONS="--require $SPOOF${NODE_OPTIONS:+ $NODE_OPTIONS}" ;;
esac
export NODE_OPTIONS

exec env __SPOOF_WRAPPER="$HOME/.local/libexec/nodespoof/node" "$REAL_NODE" "$@"
